{
  "name": "git-panel",
  "author": "lumine-code",
  "main": "./lib/index",
  "files": [
    "benchmark",
    "docs",
    "img",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "version": "1.0.0",
  "description": "A forge-agnostic Git integration panel.",
  "keywords": [
    "staging",
    "commit",
    "branch",
    "merge",
    "conflict",
    "repository",
    "push",
    "pull"
  ],
  "repository": "https://github.com/lumine-code/git-panel",
  "bugs": {
    "url": "https://github.com/lumine-code/git-panel/issues"
  },
  "homepage": "https://github.com/lumine-code/git-panel#readme",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "lumine --test benchmark"
  },
  "providedServices": {
    "git-panel": {
      "versions": {
        "1.0.0": "provideGitPanel"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#a823441dcf10e786f36915f88422fd0c95d33374",
    "classnames": "2.5.1",
    "dayjs": "^1.11.23",
    "node-emoji": "2.2.0"
  },
  "consumedServices": {
    "busy-signal": {
      "versions": {
        "^1.0.0": "consumeBusySignal"
      }
    },
    "linter.editors": {
      "versions": {
        "^1.0.0": "consumeLinterEditors"
      }
    },
    "autocomplete.watch-editor": {
      "versions": {
        "^1.0.0": "consumeAutocompleteWatchEditor"
      }
    },
    "patch-view": {
      "versions": {
        "^1.0.0": "consumePatchView"
      }
    },
    "git.commit-links": {
      "versions": {
        "^1.0.0": "consumeCommitLinks"
      }
    }
  },
  "configSchema": {
    "viewChangesForCurrentFileDiffPaneSplitDirection": {
      "title": "Direction to open diff pane",
      "description": "Direction to split the active pane when showing diff associated with open file. If 'none', the results will be shown in the active pane.",
      "type": "string",
      "enum": [
        "none",
        "right",
        "down"
      ],
      "default": "none"
    },
    "automaticCommitMessageWrapping": {
      "description": "Hard wrap commit message body in commit box to 72 characters. Does not apply to expanded commit editors, where message formatting is preserved.",
      "type": "boolean",
      "default": true
    },
    "graphicalConflictResolution": {
      "description": "Resolve merge conflicts with in-editor controls",
      "type": "boolean",
      "default": true
    },
    "excludedUsers": {
      "description": "Comma-separated list of email addresses to exclude from the co-author selection list",
      "type": "string",
      "default": ""
    },
    "reportCannotLocateWorkspaceError": {
      "description": "Log an error to the console if a git repository cannot be located for the opened file",
      "type": "boolean",
      "default": false
    },
    "remoteFetchProtocol": {
      "description": "Transport protocol to prefer when creating a new git remote",
      "type": "string",
      "enum": [
        "https",
        "ssh"
      ],
      "default": "https"
    },
    "openGitTabOnStart": {
      "description": "Automatically open the Git tab when the editor starts",
      "type": "boolean",
      "default": false
    },
    "warnLargeRepo": {
      "title": "Notify if repository is too large",
      "description": "Show a notification when a repository has too many changed files to display completely.",
      "type": "boolean",
      "default": true
    },
    "filesystemEventDiagnostics": {
      "description": "Trace observed filesystem events to the console",
      "type": "boolean",
      "default": false
    },
    "performanceMask": {
      "description": "Performance event stream patterns to capture",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        ".*"
      ]
    },
    "performanceToConsole": {
      "description": "Log performance data to the console",
      "type": "boolean",
      "default": false
    },
    "performanceToDirectory": {
      "description": "Log performance data to JSON files in a directory",
      "type": "string",
      "default": ""
    },
    "performanceToProfile": {
      "description": "Capture CPU profiles",
      "type": "boolean",
      "default": false
    },
    "debug": {
      "description": "Log additional debug information to the console, including caught errors and diagnostics",
      "type": "boolean",
      "default": false
    }
  },
  "deserializers": {
    "GitTimingsView": "createGitTimingsView",
    "GitDockItem": "createDockItemStub",
    "FilePatchControllerStub": "createFilePatchControllerStub",
    "CommitPreviewStub": "createCommitPreviewStub",
    "CommitDetailStub": "createCommitDetailStub"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  },
  "specPackages": [
    "patch-view"
  ]
}
