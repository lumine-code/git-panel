        }
      ]
    },
    {
      "label": "Packages",
      "submenu": [
        {
          "label": "Git Panel",
          "submenu": [
            {
              "label": "Toggle Git Tab",
              "command": "git-panel:toggle-git-tab"
            },
            {
              "label": "Focus Git Tab",
              "command": "git-panel:toggle-focus"
            },
            {
              "type": "separator"
            },
            {
              "label": "Toggle Commit Preview",
              "command": "git-panel:toggle-commit-preview"
            },
            {
              "label": "Open Commit",
              "command": "git-panel:open-commit"
            },
            {
              "label": "View Unstaged Changes",
              "command": "git-panel:view-unstaged-changes-for-current-file"
            },
            {
              "label": "View Staged Changes",
              "command": "git-panel:view-staged-changes-for-current-file"
            },
            {
              "label": "Close All Diff Views",
              "command": "git-panel:close-all-diff-views"
            },
            {
              "label": "Close Empty Diff Views",
              "command": "git-panel:close-empty-diff-views"
            },
            {
              "type": "separator"
            },
            {
              "label": "Initialize Repository",
              "command": "git-panel:initialize"
            },
            {
              "label": "Clone Repository",
              "command": "git-panel:clone"
            }
          ]
        }
      ]
    }
  ],
  "context-menu": {
    ".git-panel-FilePatchListView-item": [
      {
        "type": "separator"
      },
