        "label": "Jump to File",
        "command": "git-panel:jump-to-file"
      },
      {
        "type": "separator"
      }
    ],
    ".git-panel-FilePatchView--staged": [
      {
        "type": "separator"
      },
      {
        "label": "Jump to File",
        "command": "git-panel:jump-to-file",
